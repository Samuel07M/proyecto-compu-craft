CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // Separar RAM (address[14] == 0) de E/S (address[14] == 1)
    DMux(in=load, sel=address[14], a=loadram, b=loadio);

    // Si es E/S (address[14] == 1), usar address[13] para distinguir Screen (0) de Keyboard (1)
    DMux(in=loadio, sel=address[13], a=loadscreen, b=loadkbd);

    // Subcomponentes de hardware
    RAM16K(in=in, load=loadram, address=address[0..13], out=outram);
    Screen(in=in, load=loadscreen, address=address[0..12], out=outscreen);
    Keyboard(out=outkbd);

    // Multiplexor para las salidas según address[13..14]
    Mux4Way16(a=outram, b=outram, c=outscreen, d=outkbd, sel=address[13..14], out=out);
}