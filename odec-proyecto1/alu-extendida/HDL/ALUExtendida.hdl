CHIP ALUExtendida {
    IN  
        x[16], y[16], zx, nx, zy, ny, f, no;

    OUT 
        out[16], zr, ng;

    PARTS:
    // ALU Original
    // zx y nx
    Mux16(a=x, b=false, sel=zx, out=xZeroed);
    Not16(in=xZeroed, out=notXZeroed);
    Mux16(a=xZeroed, b=notXZeroed, sel=nx, out=xProcessed);

    // zy y ny
    Mux16(a=y, b=false, sel=zy, out=yZeroed);
    Not16(in=yZeroed, out=notYZeroed);
    Mux16(a=yZeroed, b=notYZeroed, sel=ny, out=yProcessed);

    // Operaciones f
    And16(a=xProcessed, b=yProcessed, out=outAnd);
    Add16(a=xProcessed, b=yProcessed, out=outAdd);

    // Operacion XOR (010110) / x XOR y = (x AND !y) OR (!x AND y)
    Not16(in=x, out=notX);
    Not16(in=y, out=notY);
    And16(a=x, b=notY, out=xAndNotY);
    And16(a=notX, b=y, out=notXAndY);
    Or16(a=xAndNotY, b=notXAndY, out=outXor, out[0..7]=xorLow, out[8..15]=xorHigh);

    // Operacion NAND (000001)
    Not16(in=outAnd, out=outNand);

    // Operacion NOR (110100)
    Or16(a=x, b=y, out=orXY);
    Not16(in=orXY, out=outNor);

    // Operacion EQ (101000)
    Or8Way(in=xorLow, out=orEqLow);
    Or8Way(in=xorHigh, out=orEqHigh);
    Or(a=orEqLow, b=orEqHigh, out=diffBits);
    Not(in=diffBits, out=isEqualBit);
    Mux16(a=false, b[0]=isEqualBit, b[1..15]=false, sel=true, out=outEq);

    // Operacion ABS (100010)
    Inc16(in=notX, out=negX);
    Mux16(a=x, b=negX, sel=x[15], out=outAbs);

    // Decodificador de señales de control
    Not(in=zx, out=notZx);
    Not(in=nx, out=notNx);
    Not(in=zy, out=notZy);
    Not(in=ny, out=notNy);
    Not(in=f,  out=notF);
    Not(in=no, out=notNo);

    // XOR 010110 -> zx=0 nx=1 zy=0 ny=1 f=1 no=0
    And(a=notZx, b=nx, out=cXor1);
    And(a=notZy, b=ny, out=cXor2);
    And(a=f, b=notNo, out=cXor3);
    And(a=cXor1, b=cXor2, out=cXor12);
    And(a=cXor12, b=cXor3, out=isXor);

    // NAND 000001 -> zx=0 nx=0 zy=0 ny=0 f=0 no=1
    And(a=notZx, b=notNx, out=cNand1);
    And(a=notZy, b=notNy, out=cNand2);
    And(a=notF, b=no, out=cNand3);
    And(a=cNand1, b=cNand2, out=cNand12);
    And(a=cNand12, b=cNand3, out=isNand);

    // NOR 110100 -> zx=1 nx=1 zy=0 ny=1 f=0 no=0
    And(a=zx, b=nx, out=cNor1);
    And(a=notZy, b=ny, out=cNor2);
    And(a=notF, b=notNo, out=cNor3);
    And(a=cNor1, b=cNor2, out=cNor12);
    And(a=cNor12, b=cNor3, out=isNor);

    // EQ 101000 -> zx=1 nx=0 zy=1 ny=0 f=0 no=0
    And(a=zx, b=notNx, out=cEq1);
    And(a=zy, b=notNy, out=cEq2);
    And(a=notF, b=notNo, out=cEq3);
    And(a=cEq1, b=cEq2, out=cEq12);
    And(a=cEq12, b=cEq3, out=isEq);

    // ABS 100010 -> zx=1 nx=0 zy=0 ny=0 f=1 no=0
    And(a=zx, b=notNx, out=cAbs1);
    And(a=notZy, b=notNy, out=cAbs2);
    And(a=f, b=notNo, out=cAbs3);
    And(a=cAbs1, b=cAbs2, out=cAbs12);
    And(a=cAbs12, b=cAbs3, out=isAbs);

    // Seleccion de salidas y generacion de banderas
    // Resultado de la ALU Original
    Mux16(a=outAnd, b=outAdd, sel=f, out=outPreStandard);
    Not16(in=outPreStandard, out=notPreStandard);
    Mux16(a=outPreStandard, b=notPreStandard, sel=no, out=outStandard);

    // Cambiar a la funcion extendida correspondiente si fue activada
    Mux16(a=outStandard, b=outXor, sel=isXor, out=m1);
    Mux16(a=m1, b=outNand, sel=isNand, out=m2);
    Mux16(a=m2, b=outNor, sel=isNor, out=m3);
    Mux16(a=m3, b=outEq, sel=isEq, out=m4);

    // Asigna out, extrae sub-buses para zr y manda el MSB directo a ng
    Mux16(a=m4, b=outAbs, sel=isAbs, out=out, out[0..7]=outLow, out[8..15]=outHigh, out[15]=ng);

    // Calculo de zr
    Or8Way(in=outLow, out=orLow);
    Or8Way(in=outHigh, out=orHigh);
    Or(a=orLow, b=orHigh, out=nozero);
    Not(in=nozero, out=zr);
}