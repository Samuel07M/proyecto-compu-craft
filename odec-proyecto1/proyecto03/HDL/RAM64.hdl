CHIP RAM64 {
    IN in[16], load, address[6];
    OUT out[16];

    PARTS:
    DMux8Way(in=load, sel=address[3..5], a=load0, b=load1, c=load2, d=load3, e=load4, f=load5, g=load6, h=load7);
    RAM8(in=in, load=load0, address=address[0..2], out=outr0);
    RAM8(in=in, load=load1, address=address[0..2], out=outr1);
    RAM8(in=in, load=load2, address=address[0..2], out=outr2);
    RAM8(in=in, load=load3, address=address[0..2], out=outr3);
    RAM8(in=in, load=load4, address=address[0..2], out=outr4);
    RAM8(in=in, load=load5, address=address[0..2], out=outr5);
    RAM8(in=in, load=load6, address=address[0..2], out=outr6);
    RAM8(in=in, load=load7, address=address[0..2], out=outr7);
    Mux8Way16(a=outr0, b=outr1, c=outr2, d=outr3, e=outr4, f=outr5, g=outr6, h=outr7, sel=address[3..5], out=out);
}